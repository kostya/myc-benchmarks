FUNC :static_fn_log_parser_c_init_ips
  ATTRIBUTES
    ATTR :private
  BODY
    PUSH 0
    GLOBAL :init_ips_initialized
    BINARY :not_eq
    IF
      THEN
        RET
    ENDIF
    PUSH 0
    LOCAL :__s1_i :i32
    STORE
    LOOP
      COND
        PUSH 255
        LOCAL :__s1_i
        BINARY :less
      BODY
        PUSH 16
        AS :u64
        CALL :malloc
        AS :ptr<u8>
        LOCAL :__s2_ip :ptr<u8>
        STORE
        PUSH 1
        LOCAL :__s1_i
        BINARY :add
        PUSH :192.168.1.%d
        PUSH 16
        AS :u64
        LOCAL :__s2_ip
        CALL :snprintf 1
        STACK :drop
        LOCAL :__s2_ip
        LOCAL :__s1_i
        AS :u64
        GLOBAL :static_log_parser_c_IPS
        ADDR
        AS :ptr<ptr<u8>>
        BINARY :add
        DEREF
        STORE
      STEP
        PUSH 1 :i32
        LOCAL :__s1_i
        BINARY :add
        LOCAL :__s1_i
        STORE
    ENDLOOP
    PUSH 1
    GLOBAL :init_ips_initialized
    STORE
ENDFUNC

