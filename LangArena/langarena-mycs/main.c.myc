FUNC :main
  ARGS
    TYPE :i32
    TYPE :ptr<ptr<u8>>
  RETURN
    TYPE :i32
  BODY
    LOCAL :__s0_start_time :timespec
    ADDR
    PUSH 0
    CALL :clock_gettime
    STACK :drop
    PUSH 1000000
    AS :i64
    LOCAL :__s0_start_time
    FIELD 1
    BINARY :div
    PUSH 1000
    AS :i64
    LOCAL :__s0_start_time
    FIELD 0
    BINARY :mul
    BINARY :add
    PUSH "start: %ld\n"
    CALL :printf 1
    STACK :drop
    PUSH 1
    PARAM 0
    BINARY :more
    IF
      THEN
        PUSH 1
        AS :u64
        PARAM 1
        BINARY :add
        DEREF
        LOCAL :__ternary_1 :ptr<u8>
        STORE
      ELSE
        PUSH :../run.js
        LOCAL :__ternary_1
        STORE
    ENDIF
    LOCAL :__ternary_1
    LOCAL :__s0_config_file :ptr<u8>
    STORE
    LOCAL :__s0_config_file
    CALL :Helper_load_config
    CALL :register_all_benchmarks
    PUSH 2
    PARAM 0
    BINARY :more
    IF
      THEN
        PUSH 2
        AS :u64
        PARAM 1
        BINARY :add
        DEREF
        LOCAL :__ternary_3 :ptr<u8>
        STORE
      ELSE
        PUSH 0
        AS :ptr<void>
        AS :ptr<u8>
        LOCAL :__ternary_3
        STORE
    ENDIF
    LOCAL :__ternary_3
    LOCAL :__s0_single_bench :ptr<u8>
    STORE
    LOCAL :__s0_single_bench
    CALL :Benchmark_all
    CALL :Helper_free_config
    PUSH 0
    AS :ptr<BenchmarkFactory>
    GLOBAL :benchmark_factories
    BINARY :not_eq
    IF
      THEN
        GLOBAL :benchmark_factories
        AS :ptr<void>
        CALL :free
        PUSH 0
        AS :ptr<void>
        AS :ptr<BenchmarkFactory>
        GLOBAL :benchmark_factories
        STORE
        PUSH 0
        AS :u64
        GLOBAL :benchmark_factories_count
        STORE
        PUSH 0
        AS :u64
        GLOBAL :benchmark_factories_capacity
        STORE
    ENDIF
    PUSH :w
    PUSH :/tmp/recompile_marker
    CALL :fopen
    LOCAL :__s1_f :ptr<_IO_FILE>
    STORE
    PUSH 0
    AS :ptr<_IO_FILE>
    LOCAL :__s1_f
    BINARY :not_eq
    IF
      THEN
        PUSH :RECOMPILE_MARKER_0
        LOCAL :__s1_f
        CALL :fprintf
        STACK :drop
        LOCAL :__s1_f
        CALL :fclose
        STACK :drop
    ENDIF
    PUSH 0
    RET
ENDFUNC

